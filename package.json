{
  "name": "bracket-reader",
  "version": "0.3.0",
  "description": "用「括号法」阅读英文长难句的油猴脚本：括出介词短语、从句、非谓语，露出主干",
  "type": "commonjs",
  "scripts": {
    "build": "node build.js",
    "test": "node test/run.js && node test/holdout.js",
    "test:accuracy": "node test/accuracy.js",
    "test:bottleneck": "node test/bottleneck.js",
    "test:e2e": "node test/e2e/accept.mjs"
  },
  "keywords": ["userscript", "tampermonkey", "english", "reading", "grammar", "bracket", "long-sentence"],
  "author": "KazooTTT",
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
